# Copy to .env and fill in. .env is never committed.

# Odds feed for live picks (client proxy). Without it the app shows the record and grades picks but makes no new ones.
ODDS_API_BASE=
ODDS_PROXY_TOKEN=
# Credit caps of the live-picks approval record (written on the first run)
LIVE_CREDIT_CAP=8000
LIVE_REQUEST_CAP=4000

# Live picks on a timer (each window costs credits). false = press Run on the Engine page.
AUTO_PICKS=false
# Free results refresh from stats.nba.com + grading, every RESULTS_EVERY_HOURS
AUTO_RESULTS=true
RESULTS_EVERY_HOURS=4

# Security
ADMIN_TOKEN=
# true on a hosted server: every page and API call needs a license key
REQUIRE_API_KEY=false
# Ed25519 private key (PEM or base64) that signs licenses; generated into data/ when empty
LICENSE_PRIVATE_KEY=
CORS_ORIGINS=*

# Database (SQLite in data/ when empty)
DATABASE_URL=

# Desktop builds: the owner's server that issues and validates licenses
LICENSE_SERVER_URL=
